ENVIRONMENT="development"
ALLOWED_ORIGINS='["http://localhost:3000"]'

# Neon Postgres (asyncpg driver)
DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname?ssl=require"

# Public URL of the Next.js site, used to refresh its cached pages after a CMS
# save. Use the final host (https://www.example.com), not one that redirects.
FRONTEND_URL="http://localhost:3000"
# Shared secret for the frontend's /api/revalidate route. Must match
# REVALIDATION_SECRET in the frontend (Vercel) environment.
REVALIDATION_SECRET="generate-a-long-random-string"

# Admin email for auth
ADMIN_EMAIL="your-admin@email.com"

# Firebase Admin SDK — path to service account JSON (local dev)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/firebase-adminsdk.json"
# OR: paste full JSON string (production/CI)
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account",...}'

# Groq AI
GROQ_API_KEY="your-groq-api-key"

# Sentry
SENTRY_DSN=""

# Cloudflare R2
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="your-bucket"
R2_PUBLIC_URL="https://your-r2-url.r2.dev"
